#!/bin/sh
set -e
if [ "$1" = "configure" ]; then
    # the board starts with every account's graphical session
    systemctl --global enable deckmate.service >/dev/null 2>&1 || true
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q 2>/dev/null || true
fi
