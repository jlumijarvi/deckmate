{
  "brightness": 60,
  "keys": {
    "0": {
      "type": "clock"
    },
    "1": {
      "title": "VS Code",
      "color": "#1f6feb",
      "run": "code"
    },
    "2": {
      "title": "Terminal",
      "color": "#2d333b",
      "run": "ptyxis --new-window"
    },
    "3": {
      "title": "Files",
      "color": "#b08968",
      "run": "xdg-open ~"
    },
    "4": {
      "title": "Browser",
      "color": "#e36209",
      "run": "xdg-open https://claude.ai"
    },
    "10": {
      "type": "counter",
      "state": "waiting"
    },
    "11": {
      "type": "counter",
      "state": "running"
    },
    "12": {
      "type": "counter",
      "state": "done"
    },
    "13": {
      "type": "pager",
      "dir": "prev"
    },
    "14": {
      "type": "pager",
      "dir": "next"
    }
  },
  "sessions": {
    "keys": [
      5,
      6,
      7,
      8,
      9
    ]
  },
  "screensaver": {
    "image": "clock",
    "timeout_min": 5,
    "sleep_min": 0
  }
}
