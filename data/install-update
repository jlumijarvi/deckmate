#!/bin/sh
# Installs a Deckmate release as root. The tray icon runs this through pkexec;
# the polkit action io.github.jlumijarvi.Deckmate.update lets the user at the
# desktop do that without a password. The only argument is a release tag
# (v0.9.4): the helper asks GitHub for that release itself, downloads the .deb
# and checks it against the SHA-256 digest GitHub publishes for the asset, so
# nothing a user hands in is ever installed as root.
set -e
TAG="$1"
echo "$TAG" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+$' || { echo "usage: install-update vX.Y.Z" >&2; exit 2; }
REPO=jlumijarvi/deckmate
TMP=$(mktemp -d /tmp/deckmate-update.XXXXXX)
trap 'rm -rf "$TMP"' EXIT
DEB="$TMP/deckmate.deb"
python3 - "$REPO" "$TAG" "$DEB" <<'PY'
import hashlib, json, re, sys, urllib.request
repo, tag, out = sys.argv[1:4]
def get(url, accept="application/vnd.github+json"):
    req = urllib.request.Request(url, headers={"Accept": accept, "User-Agent": "deckmate-install-update"})
    with urllib.request.urlopen(req, timeout=60) as r:
        return r.read()
rel = json.loads(get(f"https://api.github.com/repos/{repo}/releases/tags/{tag}"))
assets = [a for a in rel.get("assets", []) if re.fullmatch(r"deckmate_\d+\.\d+\.\d+_all\.deb", a.get("name", ""))]
if not assets:
    sys.exit(f"release {tag} has no deckmate .deb")
asset = assets[0]
digest = asset.get("digest") or ""
if not digest.startswith("sha256:"):
    sys.exit(f"release {tag}: GitHub reports no sha256 digest for {asset['name']}")
data = get(asset["browser_download_url"], accept="application/octet-stream")
if hashlib.sha256(data).hexdigest() != digest[7:]:
    sys.exit(f"{asset['name']}: downloaded file does not match the published digest")
with open(out, "wb") as f:
    f.write(data)
print(f"{asset['name']}: {len(data)} bytes, digest verified")
PY
chmod 644 "$DEB"
PKG=$(dpkg-deb -f "$DEB" Package)
[ "$PKG" = "deckmate" ] || { echo "not a deckmate package: $PKG" >&2; exit 3; }
VER=$(dpkg-deb -f "$DEB" Version)
[ "v$VER" = "$TAG" ] || { echo "package version $VER does not match $TAG" >&2; exit 3; }
export DEBIAN_FRONTEND=noninteractive
apt-get install -y -q "$DEB"
