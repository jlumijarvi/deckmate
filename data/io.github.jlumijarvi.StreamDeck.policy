<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Stream Deck</vendor>
  <vendor_url>https://github.com/jlumijarvi/stream-deck</vendor_url>
  <action id="io.github.jlumijarvi.StreamDeck.update">
    <description>Install a Stream Deck update</description>
    <message>Authentication is required to install a Stream Deck update</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/stream-deck/install-update</annotate>
  </action>
</policyconfig>
